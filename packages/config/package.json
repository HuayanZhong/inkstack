{
  "name": "@inkstack/config",
  "version": "0.0.0",
  "private": true,
  "description": "墨栈共享配置包，提供环境变量解析与校验、URL 与前缀标准化，供各应用在启动时构建类型化配置。",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "publint": "publint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@inkstack/tsconfig": "workspace:*",
    "publint": "catalog:dev",
    "typescript": "catalog:toolchain"
  }
}
