{
  "name": "@inkstack/vitest-config",
  "version": "0.0.0",
  "private": true,
  "description": "墨栈共享 Vitest 配置包，提供 Node、React 与 Nest 三种测试预设。",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@inkstack/tsconfig": "workspace:*",
    "publint": "catalog:dev",
    "typescript": "catalog:toolchain",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
