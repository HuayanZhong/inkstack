{
  "name": "@inkstack/ui",
  "version": "0.0.0",
  "private": true,
  "description": "墨栈共享 UI 包，提供 shadcn 组件、cn 工具与 Tailwind 主题样式，供 shell 与 canvas 消费。",
  "license": "ISC",
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "source": "./src/components/*",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "source": "./src/lib/*",
      "default": "./dist/lib/*.js"
    },
    "./globals.css": "./styles/globals.css"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:runtime",
    "class-variance-authority": "catalog:runtime",
    "cn": "catalog:runtime",
    "lucide-react": "catalog:runtime",
    "next-themes": "catalog:runtime"
  },
  "devDependencies": {
    "@inkstack/tsconfig": "workspace:*",
    "@inkstack/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "jsdom": "catalog:dev",
    "publint": "catalog:dev",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "shadcn": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "tw-animate-css": "catalog:dev",
    "typescript": "catalog:toolchain",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime"
  }
}
