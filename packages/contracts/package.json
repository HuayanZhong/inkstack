{
  "name": "@inkstack/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared action protocol, types, and code-generation IR for Inkstack.",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware .",
    "publint": "publint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@inkstack/tsconfig": "workspace:*",
    "publint": "catalog:dev",
    "typescript": "catalog:toolchain"
  }
}
