{
  "name": "@inkstack/canvas",
  "version": "0.0.0",
  "private": true,
  "description": "tldraw 画布应用，负责渲染设计稿，并作为所有画布 action 的唯一执行者。",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "rspack serve --mode development",
