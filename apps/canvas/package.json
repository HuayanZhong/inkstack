    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "tldraw": "catalog:runtime"
  },
  "devDependencies": {
    "@inkstack/tsconfig": "workspace:*",
    "@module-federation/enhanced": "catalog:runtime",
    "@rspack/cli": "catalog:dev",
    "@rspack/core": "catalog:dev",
    "@rspack/dev-server": "catalog:dev",
    "@rspack/plugin-react-refresh": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "autoprefixer": "catalog:dev",
    "css-loader": "catalog:dev",
    "postcss": "catalog:dev",
    "postcss-loader": "catalog:dev",
    "react-refresh": "catalog:dev",
    "ts-node": "catalog:dev",
    "typescript": "catalog:toolchain"
  }
