{
  "name": "@inkstack/shell",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js 应用外壳，承载墨栈的产品页面、布局与后续的画布嵌入，是用户访问的入口应用。",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -e ../../.env.development -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env.local -e ../../.env.production -e ../../.env -- next build",
    "lint": "dotenv -e ../../.env.local -e ../../.env.development -e ../../.env -e ../../.env.example -- next typegen && oxlint --config ../../.oxlintrc.json --type-aware .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "dotenv -e ../../.env.local -e ../../.env.development -e ../../.env -e ../../.env.example -- next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@inkstack/config": "workspace:*",
    "@inkstack/ui": "workspace:*",
    "next": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime"
  },
  "devDependencies": {
    "@inkstack/tsconfig": "workspace:*",
    "@inkstack/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:dev",
    "@testing-library/dom": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "dotenv-cli": "catalog:dev",
    "jsdom": "catalog:dev",
    "typescript": "catalog:toolchain",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
