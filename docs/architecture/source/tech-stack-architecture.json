  "cards": [
    {
      "dot": "cyan",
      "title": "分层顺序",
      "items": [
        "接入层 → 前端技术 → 微前端 → BFF 层 → 协议层 → 后端服务 → 数据层 → AI 层 → 工程化",
        "BFF 是独立一层：前端聚合 / Auth / SSE；Gateway 仍是内部 action 序列器",
        "服务层先以 NestJS 模块化单体落地，再拆无状态服务"
      ]
    },
    {
      "dot": "orange",
      "title": "BFF 层（独立）",
      "items": [
        "位置：前端与后端服务之间，单独一层",
        "职责：聚合 Gateway / Agent / Codegen，Auth/session，SSE，上传/下载",
        "实现：NestJS BFF 或 Next.js Route Handlers",
        "边界：不持有 action 队列，不做画布执行"
      ]
    },
    {
      "dot": "violet",
      "title": "微前端",
      "items": [
        "Canvas 作为 Module Federation provider（remote），Next.js Shell 用 runtime API 消费",
        "共享 React / ReactDOM 单例，画布组件仅客户端加载",
        "App Router 不支持 nextjs-mf；shell 用 @module-federation/enhanced/runtime"
      ]
    },
    {
      "dot": "amber",
      "title": "Supabase（BaaS）",
      "items": [
        "放在后端服务层：Postgres / Auth / Storage / Realtime",
        "NestJS 仍是业务编排层，Supabase 不替代 NestJS",
        "本地开发仍可用 SQLite + MikroORM"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI 框架与多 Agent 编排",
      "items": [
        "模型调用 / 流式：Vercel AI SDK（ai + @ai-sdk/anthropic）",
        "多 Agent 编排：LangGraph.js（图 / 状态 / 检查点 / HITL）",
        "Deep Agents：基于 LangGraph 的高层 harness（规划 / 子 Agent / MCP），候选",
        "画布执行：tldraw Agent Kit；外部接入：MCP SDK",
        "Mastra 作为 TypeScript-native 备选；不要同时上两套编排层"
      ]
    },
    {
      "dot": "slate",
      "title": "候选与关键选型",
      "items": [
        "Nest TCP / Redis：拆服务或需要 pub/sub 时启用",
        "Docker Compose：本地多服务编排时启用",
        "画布 tldraw Agent kit（MIT）；代码生成用确定性编译器；契约用 Zod 共享"
      ]
    }
  ]
}
