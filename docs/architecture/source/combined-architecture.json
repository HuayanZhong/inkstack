  "cards": [
    {
      "dot": "cyan",
      "title": "三条主流程",
      "items": [
        "内嵌 AI：Chat → BFF → Agent Service → Gateway → Canvas",
        "人工编辑：Canvas → Gateway → design.json",
        "外部 Agent：MCP Adapter → Gateway → Canvas"
      ]
    },
    {
      "dot": "rose",
      "title": "关键约束",
      "items": [
        "BFF 是独立一层：前端聚合 / Auth / SSE；实时 WS 可直连 Gateway",
        "Gateway 是单一序列器，所有 action 排队并编号",
        "Canvas 是单一执行器，负责调用 tldraw editor 并回 ack",
        "写操作要求画布在线；读与 codegen 可离线使用最后快照"
      ]
    },
    {
      "dot": "emerald",
      "title": "协议",
      "items": [
        "浏览器与 BFF：HTTP / SSE；实时动作：WS 可直连 Gateway",
        "内嵌聊天：BFF 聚合后 SSE 流式响应",
        "外部接入：MCP stdio，平台阶段换 HTTP",
        "服务间：Nest TCP / Redis（候选）"
      ]
    },
    {
      "dot": "violet",
      "title": "Supabase（可选）",
      "items": [
        "Auth / Storage / Postgres 作为平台化能力接入",
        "不进入主 action 流；本地仍以 design.json 为准"
      ]
    }
  ]
