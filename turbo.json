{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": true,
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "CANVAS_HOST",
    "CANVAS_PORT",
    "CANVAS_DEV_CORS_ORIGIN",
    "BFF_PORT",
    "NEXT_PUBLIC_CANVAS_MF_ENTRY"
  ],
  "tasks": {
    "build": {
      "description": "构建所有包，产出 dist 与 .next 构建产物；env 文件变化时缓存失效。",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "description": "启动各应用的开发服务器；先构建依赖包，长期运行且不缓存。",
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "description": "启动各应用的生产服务；先构建依赖包，长期运行且不缓存。",
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "description": "按包执行 oxlint 检查；先构建依赖包，根规则文件变化时缓存失效。",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "description": "按包执行 TypeScript 类型检查；先构建依赖包，不产出文件。",
      "dependsOn": ["^build"]
    },
    "publint": {
      "description": "校验库包的 package.json 导出映射；先构建出 dist，避免干净检出时目标文件缺失。",
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
