{
  "name": "inkstack",
  "version": "0.0.1",
  "private": true,
  "description": "一个支持ai d2c的项目",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:commit": "commitlint",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "design-to-code",
    "tldraw",
    "monorepo",
    "turborepo"
  ],
  "author": "huayan",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuayanZhong/inkstack.git"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@commitlint/config-conventional": "catalog:dev",
    "@fission-ai/openspec": "catalog:dev",
    "@types/node": "^24.19.2",
    "commitlint": "catalog:dev",
    "husky": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
