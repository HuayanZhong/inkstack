{
  "name": "inkstack",
  "version": "0.0.0",
  "private": true,
  "description": "Inkstack — an AI design-to-code canvas with agent pen control, manual editing, and deterministic code generation.",
  "keywords": [
    "ai",
    "design-to-code",
    "monorepo",
    "tldraw",
    "turborepo"
  ],
  "license": "ISC",
  "author": "huayan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuayanZhong/inkstack.git"
  },
  "type": "module",
  "scripts": {
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:docs": "node scripts/check-agent-docs.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hygiene": "turbo run build --filter \"./packages/*\" && knip && turbo run publint --filter \"./packages/*\"",
    "publint": "turbo run publint --filter \"./packages/*\"",
    "lint": "turbo run lint && oxlint --config .oxlintrc.turbo.json .",
    "lint:env": "oxlint --config .oxlintrc.turbo.json .",
    "lint:commit": "commitlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "pnpm install --frozen-lockfile && pnpm lint && pnpm check:manifests && pnpm check:docs && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm format:check && pnpm hygiene",
    "prepare": "husky",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@fission-ai/openspec": "catalog:toolchain",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "eslint-plugin-turbo": "catalog:dev",
    "husky": "catalog:dev",
    "knip": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:toolchain",
    "oxlint": "catalog:toolchain",
    "oxlint-tsgolint": "catalog:toolchain",
    "turbo": "catalog:dev",
    "typescript": "catalog:toolchain",
    "yaml": "catalog:dev"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --config .oxlintrc.staged.json --ignore-pattern \"**/.agents/**\""
    ],
    "*.{json,jsonc,md,mdx,yml,yaml,css,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
