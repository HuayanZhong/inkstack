{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["eslint-plugin-turbo"],
  "rules": {
    "turbo/no-undeclared-env-vars": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "openspec/changes/archive/**"
  ]
}
