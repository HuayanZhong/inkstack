# ============================================================
# 墨栈 Inkstack 环境变量模板
# ============================================================
#
# 加载机制（应用 scripts 通过 dotenv-cli 注入）：
#   dev   → .env.local → .env.development → .env
#   build → .env.local → .env.production  → .env
#   test  → 由测试命令显式加载 .env.test
#
# 本地首次使用：cp .env.example .env
#
# 文件分工：
#   .env              共享默认值
#   .env.development  开发环境覆盖
#   .env.production   生产环境覆盖
#   .env.test         测试环境覆盖
#   .env.local        个人/部署覆盖层，优先级最高，不入库
#
# 只有本文件入库；其余 .env* 均在 .gitignore 中。

# ============================================================
# 客户端可见
# 构建时内联到浏览器产物，会暴露给终端用户，禁止放密钥
# ============================================================
NEXT_PUBLIC_CANVAS_MF_ENTRY=http://localhost:4002/mf-manifest.json

# ============================================================
# 端口与开发服务器
# Next 应用端口用 PORT；其他应用用 <APP>_PORT
# ============================================================
PORT=3000
CANVAS_HOST=localhost
CANVAS_PORT=4002
BFF_PORT=4003
GATEWAY_PORT=4001
# Gateway 的 Socket.IO 握手路径
GATEWAY_WS_PATH=/ws
# canvas dev server 的 CORS origin；生产由托管配置负责
CANVAS_DEV_CORS_ORIGIN=*

# ============================================================
# 服务端专用（不得加 NEXT_PUBLIC_ 前缀）
# ============================================================
# Supabase（后续接入）
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AI 模型（后续接入 agent-service）
# ANTHROPIC_API_KEY=

# ============================================================
# 测试环境
# 由测试命令显式加载，不参与 dev / prod 链
# ============================================================
# NEXT_PUBLIC_CANVAS_MF_ENTRY=http://localhost:4002/mf-manifest.json
# SUPABASE_TEST_EMAIL=
# SUPABASE_TEST_PASSWORD=
